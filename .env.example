# =============================================================================
# Sovereign Search — Environment Configuration Example
# =============================================================================

# Local SearXNG Meta-Search URL (optional, defaults to http://127.0.0.1:8888)
SOVEREIGN_SEARXNG_URL=http://127.0.0.1:8888

# SearXNG Secret Key (generate a secure random 32-byte hex string: openssl rand -hex 32)
SEARXNG_SECRET=replace_this_with_a_random_32_byte_hex_key

# Knowledge Vault SQLite Database Path (optional, defaults to ~/.sovereign-search/vault.db)
SOVEREIGN_VAULT_PATH=~/.sovereign-search/vault.db
